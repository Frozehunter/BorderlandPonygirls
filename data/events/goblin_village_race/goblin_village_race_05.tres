[resource]
script = ExtResource("3_sxu30")
titel = "Goblin Village Scramble"
description = "The preparation area is crowded with mares, jockeys, and goblin attendants shouting over one another. Harnesses are tightened, saddles adjusted, and last-minute advice exchanged with varying degrees of usefulness.

Pick the mare you want under you. A goblin attendant inspects her straps with surprising care, gives her a pat on the rump, and attaches your numbered ribbon.

“Looks good, {TITLE}. Get to the starting stalls when you’re ready - and hold on tight.”"
content = Array[ExtResource("2_6fqt8")]([SubResource("Resource_f46yg")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
