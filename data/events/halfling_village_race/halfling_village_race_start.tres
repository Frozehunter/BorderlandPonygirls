[resource]
script = ExtResource("11_4v8sr")
titel = "Halfling Village Derby"
img = ExtResource("99_raceimg")
description = "You arrive at the racetrack to find it packed with excited onlookers, all eager to witness one of those fancy ponygirl races everyone has been talking about."
