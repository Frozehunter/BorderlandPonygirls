[sub_resource type="Resource" id="Resource_4inwj"]
script = ExtResource("4_pdny1")
txt = "The track is a dusty road, surrounding a local farm. A large farmhouse stands at the far end, flanked by two imposing granary towers. A pristine white fence surrounds the entire course, giving the humble farm a nice and polished appearance."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_rusv4"]
script = ExtResource("5_gm5k8")
txt = "Look over the track"
actions = Array[ExtResource("1_qfde6")]([SubResource("Resource_4inwj")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_caaox"]
script = ExtResource("4_pdny1")
txt = "The crowd consists mostly of local halfling farmers and their families. Food stalls, beer stands, and cheerful music give the event the atmosphere of a village festival. Ponygirl racing may be a new sport in these parts, but it has already attracted plenty of curious spectators."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_2u8ah"]
script = ExtResource("5_gm5k8")
txt = "Observe the crowd"
actions = Array[ExtResource("1_qfde6")]([SubResource("Resource_caaox")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_q2q63"]
script = ExtResource("4_pdny1")
txt = "Most of the competing mares are trained for farm work or service in warbands rather than racing. Their jockeys are a lively mixture of halflings and goblins, few of whom appear to have any real experience on the track."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_7nnse"]
script = ExtResource("5_gm5k8")
txt = "Study the competition"
actions = Array[ExtResource("1_qfde6")]([SubResource("Resource_q2q63")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[sub_resource type="Resource" id="Resource_hpblf"]
script = ExtResource("4_pdny1")
txt = "A row of hastily constructed starting stalls stands beside the farmhouse. Several halfling organizers hurry about with lists and colored ribbons, doing their best to appear professional despite the occasional argument over rules."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_m6gfv"]
script = ExtResource("5_gm5k8")
txt = "Inspect the starting area"
actions = Array[ExtResource("1_qfde6")]([SubResource("Resource_hpblf")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

