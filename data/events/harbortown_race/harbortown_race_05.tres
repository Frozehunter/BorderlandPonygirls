[resource]
script = ExtResource("3_vhapx")
titel = "Harbortown Circuit"
description = "You enter the preparation area and find it bustling with activity. Jockeys tighten straps, attendants inspect harnesses, and racing mares stretch or shift restlessly beneath the roar of the nearby crowd.

Pick the mare you want under you. An official examines every buckle and fastening before attaching your numbered ribbon to the harness.

“Everything is in order, {TITLE},” he says. “Take your place at the starting stalls when you’re ready.”"
content = Array[ExtResource("2_2q3su")]([SubResource("Resource_aimwn")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
