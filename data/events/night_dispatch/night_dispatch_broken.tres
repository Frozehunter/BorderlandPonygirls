[resource]
script = ExtResource("8")
titel = "Night Dispatch"
description = "The wax parts clean. Inside: a short hand, no seal-name.

The post still honors the protection pact. No raiding parties south of the stream this moon. The millers will pay the levy. The village will keep its horseshoe tax.

You can press the wax back down. It will not fool fingers that know wax."
img = ExtResource("9")
content = Array[ExtResource("2")]([SubResource("Resource_ride"), SubResource("Resource_sell")])
open_actions = Array[ExtResource("1")]([SubResource("Resource_opened")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
