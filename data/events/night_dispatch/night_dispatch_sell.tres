[resource]
script = ExtResource("8")
titel = "Night Dispatch"
description = "A factor with no badge finds you by the warehouse wall. She does not ask to read it. She weighs the packet, then your face, then counts {GOOD_WAGE} into your palm.

\"The village will hear a rumor,\" she says. \"Not a letter.\"

The night road stays empty behind you."
img = ExtResource("9")
open_actions = Array[ExtResource("1")]([SubResource("Resource_flag"), SubResource("Resource_gold"), SubResource("Resource_repute")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
