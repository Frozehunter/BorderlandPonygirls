[sub_resource type="Resource" id="Resource_dmaue"]
script = ExtResource("8_lvu3u")
text = "As you walk through the streets, you overhear two locals discussing an upcoming ponygirl race. You stop to ask for details and learn that races have been announced at tracks throughout the region."
metadata/_custom_type_script = "uid://ckie55vduhbok"

[sub_resource type="Resource" id="Resource_rnl8d"]
script = ExtResource("8_lvu3u")
text = "A newly posted notice at the local tavern catches your attention. It announces another round of ponygirl races, with events being held at every established track in the region.

All properly equipped racers are invited to enter."
metadata/_custom_type_script = "uid://ckie55vduhbok"

[sub_resource type="Resource" id="Resource_6qnyu"]
script = ExtResource("8_lvu3u")
text = "A town crier stands at a busy crossroads, loudly announcing the next series of ponygirl races. According to him, every racetrack in the region is accepting competitors."
metadata/_custom_type_script = "uid://ckie55vduhbok"

[sub_resource type="Resource" id="Resource_8rwv6"]
script = ExtResource("8_lvu3u")
text = "You pass a group of excited locals debating which ponygirl race they should attend. When you ask what they are talking about, they explain that new races have been announced across the region."
metadata/_custom_type_script = "uid://ckie55vduhbok"

[sub_resource type="Resource" id="Resource_pypi1"]
script = ExtResource("8_lvu3u")
text = "A travelling race promoter is handing out notices and enthusiastically advertising the latest ponygirl races. Events are being organized at tracks throughout the region, and anyone with a proper mare and gear may enter."
metadata/_custom_type_script = "uid://ckie55vduhbok"

