[resource]
script = ExtResource("6")
titel = "Stable Fair"
description = "A traveling stable fair has set up pens at the edge of the post. Handlers walk trained ponygirls in tight circles so buyers can judge gait, submission, and spirit.

Mares are offered by type - submission, training, and temper - not by famous names. Each visit brings different stock."
content = Array[ExtResource("2_svys2")]([SubResource("Resource_btn_loyal"), SubResource("Resource_btn_needy"), SubResource("Resource_btn_green"), SubResource("Resource_btn_sub"), SubResource("Resource_btn_strong"), SubResource("Resource_btn_wild"), SubResource("Resource_btn_leave")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
