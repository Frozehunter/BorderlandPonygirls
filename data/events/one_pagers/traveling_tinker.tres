[sub_resource type="Resource" id="Resource_check_charm"]
script = ExtResource("6")
ability = 2
succes_actions = Array[ExtResource("1_02lps")]([SubResource("Resource_sway_gold"), SubResource("Resource_j7ksy"), SubResource("Resource_sway_back_ok")])
fail_actions = Array[ExtResource("1_02lps")]([SubResource("Resource_sway_repute_fail"), SubResource("Resource_sway_back_fail")])
txt = "Charm him into a free tune-up"
succes_txt = "He laughs, waves off payment, and still does a solid job - even slips you a few coins “for the road,” claiming a warband boss is good advertising."
fail_txt = "Your charm falls flat. He snorts that he doesn’t work for free for “every two-bit boss with a string of mares,” and several villagers overhear."
metadata/_custom_type_script = "uid://b7vmcwnbxge0e"

[sub_resource type="Resource" id="Resource_btn_leave"]
script = ExtResource("5")
txt = "Move on"
metadata/_custom_type_script = "uid://0o5ru8obqsel"

[resource]
script = ExtResource("8")
titel = "Traveling Tinker"
description = "Near the village green a traveling tinker has spread a worn blanket with tools, spare buckles, and pots of leather oil. He eyes your ponygirls’ harness with a professional squint.

“Good stock,” he says. “Gear’s serviceable - but I can make it sit cleaner. Less chafe, tighter silhouette. Fair price for a warband of your size.”"
img = ExtResource("11_6w2gu")
content = Array[ExtResource("2_lacbe")]([SubResource("Resource_btn_pay"), SubResource("Resource_check_charm"), SubResource("Resource_btn_leave")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
