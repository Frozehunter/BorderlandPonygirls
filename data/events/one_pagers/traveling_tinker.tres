[sub_resource type="Resource" id="Resource_pay_desc"]
script = ExtResource("1")
txt = "The tinker works quickly. Leather creaks as he oils straps, tightens buckles, and mutters about “half-done goblin knots.” Your ponygirls stand quieter afterward - gear sitting better, less chafe, more pride in how they look."
metadata/_custom_type_script = "uid://cjt27rj7fiwsv"

[sub_resource type="Resource" id="Resource_pay_gold"]
script = ExtResource("2")
amount = "-{COST_REST}"
metadata/_custom_type_script = "uid://b2kag3ewwrnih"

[sub_resource type="Resource" id="Resource_pay_submission"]
script = ExtResource("3")
amount = 5
target = 2
metadata/_custom_type_script = "uid://cy0fnw6jwovce"

[sub_resource type="Resource" id="Resource_pay_back"]
script = ExtResource("4")
metadata/_custom_type_script = "uid://b0g16xoo4jggg"

[sub_resource type="Resource" id="Resource_btn_pay"]
script = ExtResource("5")
txt = "Pay for tack service"
actions = Array[ExtResource("1_02lps")]([SubResource("Resource_pay_desc"), SubResource("Resource_pay_gold"), SubResource("Resource_pay_submission"), SubResource("Resource_pay_back")])
metadata/_custom_type_script = "uid://0o5ru8obqsel"

