[resource]
script = ExtResource("3_8k4q2")
titel = "Ponygirl outfitter"
show_as_quest = false
description = "Tucked away behind an unassuming storefront is a surprisingly large shop filled with the rich scents of leather and oiled steel. Bridles, crops, whips, harnesses, saddles, and countless straps cover the walls and display tables. Every piece appears to be of exceptional quality.

An open doorway at the back leads into a busy workshop. Tools move amid the flicker of a faint magical glow, suggesting that more than ordinary craftsmanship goes into the merchandise sold here.

Behind the counter stands the proprietor: an elderly goblin with weathered features and an eyepatch, watching you with his single sharp eye."
content = Array[ExtResource("2_74r5s")]([SubResource("Resource_q6xwx"), SubResource("Resource_77dvc")])
open_actions = Array[ExtResource("1_te7kq")]([SubResource("Resource_open")])
metadata/_custom_type_script = "uid://47s8j4k2usde"
